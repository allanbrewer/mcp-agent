{
    "servers": [
        {
            "id": "github",
            "description": "Interacts with GitHub repositories, issues, pull requests, etc.",
            "command": {
                "defaultExecutable": "docker",
                "argsTemplate": [
                    "run",
                    "-i",
                    "--rm",
                    "-e",
                    "GITHUB_PERSONAL_ACCESS_TOKEN={GITHUB_PAT}",
                    "ghcr.io/github/github-mcp-server"
                ],
                "envVars": [
                    "GITHUB_PERSONAL_ACCESS_TOKEN"
                ]
            },
            "tools": [
                {
                    "name": "get_issue",
                    "description": "Gets the contents of an issue within a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (user or organization)."
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name."
                            },
                            "issue_number": {
                                "type": "NUMBER",
                                "description": "Issue number."
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "issue_number"
                        ]
                    }
                },
                {
                    "name": "search_repositories",
                    "description": "Searches for GitHub repositories",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "query": {
                                "type": "STRING",
                                "description": "Search query (string, required)"
                            },
                            "sort": {
                                "type": "STRING",
                                "description": "Sort field (string, optional)"
                            },
                            "order": {
                                "type": "STRING",
                                "description": "Sort order (string, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number (number, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            }
                        },
                        "required": [
                            "query"
                        ]
                    }
                },
                {
                    "name": "list_issues",
                    "description": "List and filter repository issues.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "state": {
                                "type": "STRING",
                                "description": "Filter by state ('open', 'closed', 'all') (string, optional)"
                            },
                            "labels": {
                                "type": "STRING",
                                "description": "Labels to filter by (string[], optional)"
                            },
                            "sort": {
                                "type": "STRING",
                                "description": "Sort by ('created', 'updated', 'comments') (string, optional)"
                            },
                            "direction": {
                                "type": "STRING",
                                "description": "Sort direction ('asc', 'desc') (string, optional)"
                            },
                            "since": {
                                "type": "STRING",
                                "description": "Filter by date (ISO 8601 timestamp) (string, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number (number, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo"
                        ]
                    }
                },
                {
                    "name": "get_pull_request",
                    "description": "Get details of a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "create_issue",
                    "description": "Create a new issue in a GitHub repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "title": {
                                "type": "STRING",
                                "description": "Issue title (string, required)"
                            },
                            "body": {
                                "type": "STRING",
                                "description": "Issue body content (string, optional)"
                            },
                            "assignees": {
                                "type": "STRING",
                                "description": "Usernames to assign to this issue (string[], optional)"
                            },
                            "labels": {
                                "type": "STRING",
                                "description": "Labels to apply to this issue (string[], optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "title"
                        ]
                    }
                },
                {
                    "name": "get_pull_request_files",
                    "description": "Get files for a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "get_pull_request_status",
                    "description": "Get status for a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "update_pull_request_branch",
                    "description": "Update a pull request branch.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "get_pull_request_comments",
                    "description": "Get comments for a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "get_pull_request_reviews",
                    "description": "Get reviews for a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "create_pull_request_review",
                    "description": "Create a review for a specific pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            },
                            "body": {
                                "type": "STRING",
                                "description": "Review body content (string, optional)"
                            },
                            "event": {
                                "type": "STRING",
                                "description": "The event to perform on the pull request review. Can be one of: APPROVE, REQUEST_CHANGES, COMMENT (string, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "create_pull_request",
                    "description": "Create a pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "title": {
                                "type": "STRING",
                                "description": "The title of the pull request (string, required)"
                            },
                            "head": {
                                "type": "STRING",
                                "description": "The name of the branch where your changes are implemented (string, required)"
                            },
                            "base": {
                                "type": "STRING",
                                "description": "The name of the branch you want the changes pulled into (string, required)"
                            },
                            "body": {
                                "type": "STRING",
                                "description": "The contents of the pull request (string, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "title",
                            "head",
                            "base"
                        ]
                    }
                },
                {
                    "name": "update_pull_request",
                    "description": "Update a pull request.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "pullNumber": {
                                "type": "NUMBER",
                                "description": "Pull request number (number, required)"
                            },
                            "title": {
                                "type": "STRING",
                                "description": "The title of the pull request (string, optional)"
                            },
                            "body": {
                                "type": "STRING",
                                "description": "The contents of the pull request (string, optional)"
                            },
                            "state": {
                                "type": "STRING",
                                "description": "State of the pull request. Can be open or closed (string, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "pullNumber"
                        ]
                    }
                },
                {
                    "name": "create_or_update_file",
                    "description": "Create or update a file in a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "path": {
                                "type": "STRING",
                                "description": "The path to the file (string, required)"
                            },
                            "message": {
                                "type": "STRING",
                                "description": "Commit message (string, required)"
                            },
                            "content": {
                                "type": "STRING",
                                "description": "File content, which must be base64 encoded (string, required)"
                            },
                            "branch": {
                                "type": "STRING",
                                "description": "The name of the branch you want to make the commit on (string, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "path",
                            "message",
                            "content"
                        ]
                    }
                },
                {
                    "name": "push_files",
                    "description": "Push multiple files to a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "branch": {
                                "type": "STRING",
                                "description": "The name of the branch you want to make the commit on (string, required)"
                            },
                            "files": {
                                "type": "STRING",
                                "description": "List of files to push (string[], required)"
                            },
                            "commit_message": {
                                "type": "STRING",
                                "description": "Commit message (string, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "branch",
                            "files",
                            "commit_message"
                        ]
                    }
                },
                {
                    "name": "create_repository",
                    "description": "Create a new repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "name": {
                                "type": "STRING",
                                "description": "The name of the repository (string, required)"
                            },
                            "description": {
                                "type": "STRING",
                                "description": "A short description of the repository (string, optional)"
                            },
                            "private": {
                                "type": "BOOLEAN",
                                "description": "Whether the repository should be private (boolean, optional)"
                            }
                        },
                        "required": [
                            "name"
                        ]
                    }
                },
                {
                    "name": "get_file_contents",
                    "description": "Get the contents of a file in a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "path": {
                                "type": "STRING",
                                "description": "The path to the file (string, required)"
                            },
                            "ref": {
                                "type": "STRING",
                                "description": "The name of the commit/branch/tag. Defaults to the repository’s default branch (string, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "path"
                        ]
                    }
                },
                {
                    "name": "fork_repository",
                    "description": "Fork a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo"
                        ]
                    }
                },
                {
                    "name": "create_branch",
                    "description": "Create a branch in a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "branch": {
                                "type": "STRING",
                                "description": "The name of the new branch (string, required)"
                            },
                            "sha": {
                                "type": "STRING",
                                "description": "The commit SHA to create the branch from (string, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "branch",
                            "sha"
                        ]
                    }
                },
                {
                    "name": "list_commits",
                    "description": "List commits in a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "sha": {
                                "type": "STRING",
                                "description": "SHA or branch to start listing commits from (string, optional)"
                            },
                            "path": {
                                "type": "STRING",
                                "description": "Only commits containing this file path will be returned (string, optional)"
                            },
                            "author": {
                                "type": "STRING",
                                "description": "GitHub login or email address by which to filter by commit author (string, optional)"
                            },
                            "since": {
                                "type": "STRING",
                                "description": "Only show commits after this date. This is a timestamp in ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ (string, optional)"
                            },
                            "until": {
                                "type": "STRING",
                                "description": "Only show commits before this date. This is a timestamp in ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ (string, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number (number, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo"
                        ]
                    }
                },
                {
                    "name": "search_code",
                    "description": "Search code in a repository.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "q": {
                                "type": "STRING",
                                "description": "The search terms. This can be any combination of the supported code search qualifiers (string, required)"
                            },
                            "sort": {
                                "type": "STRING",
                                "description": "Sort matches by size or path (string, optional)"
                            },
                            "order": {
                                "type": "STRING",
                                "description": "Determines whether the first search result returned is the highest number of matches (string, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number of the results to fetch (number, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "q"
                        ]
                    }
                },
                {
                    "name": "search_users",
                    "description": "Search users on GitHub.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "q": {
                                "type": "STRING",
                                "description": "The search terms (string, required)"
                            },
                            "sort": {
                                "type": "STRING",
                                "description": "Sort matches by followers, repositories, or joined (string, optional)"
                            },
                            "order": {
                                "type": "STRING",
                                "description": "Determines whether the first search result returned is the highest number of matches (string, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number of the results to fetch (number, optional)"
                            }
                        },
                        "required": [
                            "q"
                        ]
                    }
                },
                {
                    "name": "get_code_scanning_alert",
                    "description": "Get a code scanning alert.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "alert_number": {
                                "type": "NUMBER",
                                "description": "The number that identifies an alert. (number, required)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo",
                            "alert_number"
                        ]
                    }
                },
                {
                    "name": "list_code_scanning_alerts",
                    "description": "List code scanning alerts.",
                    "parameters": {
                        "type": "OBJECT",
                        "properties": {
                            "owner": {
                                "type": "STRING",
                                "description": "Repository owner (string, required)"
                            },
                            "repo": {
                                "type": "STRING",
                                "description": "Repository name (string, required)"
                            },
                            "state": {
                                "type": "STRING",
                                "description": "The state of the code scanning alerts to list. Can be: open, dismissed, or all (string, optional)"
                            },
                            "severity": {
                                "type": "STRING",
                                "description": "The severity of the code scanning alerts to list. Can be: critical, high, medium, low, or warning (string, optional)"
                            },
                            "sort": {
                                "type": "STRING",
                                "description": "The property to sort the results by. Can be: created_at or state (string, optional)"
                            },
                            "direction": {
                                "type": "STRING",
                                "description": "The direction to sort the results by. Can be: asc or desc (string, optional)"
                            },
                            "perPage": {
                                "type": "NUMBER",
                                "description": "Results per page (number, optional)"
                            },
                            "page": {
                                "type": "NUMBER",
                                "description": "Page number of the results to fetch (number, optional)"
                            }
                        },
                        "required": [
                            "owner",
                            "repo"
                        ]
                    }
                }
            ]
        }
    ]
}