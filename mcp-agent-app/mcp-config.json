{
    "servers": [
        {
            "id": "whatsapp",
            "description": "Manages WhatsApp interactions (messages, contacts, chats).",
            "command": {
                "executableEnvVar": "UV_PATH",
                "defaultExecutable": "uv",
                "argsTemplate": [
                    "run",
                    "--directory",
                    "{SCRIPT_DIR}",
                    "main.py"
                ],
                "argSubstitutions": {
                    "{SCRIPT_DIR}": "WHATSAPP_MCP_SCRIPT_DIR"
                }
            }
        },
        {
            "id": "github",
            "description": "Interacts with GitHub repositories, issues, pull requests, etc.",
            "command": {
                "defaultExecutable": "docker",
                "argsTemplate": [
                    "run",
                    "-i",
                    "--rm",
                    "-e",
                    "GITHUB_PERSONAL_ACCESS_TOKEN={GITHUB_PAT}",
                    "ghcr.io/github/github-mcp-server"
                ],
                "argSubstitutions": {
                    "{GITHUB_PAT}": "GITHUB_PERSONAL_ACCESS_TOKEN"
                },
                "envVars": []
            }
        },
        {
            "id": "gsuite",
            "description": "Manages Gmail and Google Calendar interactions.",
            "command": {
                "executableEnvVar": "UV_PATH",
                "defaultExecutable": "uv",
                "argsTemplate": [
                    "run",
                    "--directory",
                    "{GSUITE_MCP_SCRIPT_DIR}",
                    "mcp-gsuite",
                    "--gauth-file",
                    "{GSUITE_GAUTH_FILE}",
                    "--accounts-file",
                    "{GSUITE_ACCOUNTS_FILE}",
                    "--credentials-dir",
                    "{GSUITE_CREDENTIALS_DIR}"
                ],
                "argSubstitutions": {
                    "{GSUITE_MCP_SCRIPT_DIR}": "GSUITE_MCP_SCRIPT_DIR",
                    "{GSUITE_GAUTH_FILE}": "GSUITE_GAUTH_FILE",
                    "{GSUITE_ACCOUNTS_FILE}": "GSUITE_ACCOUNTS_FILE",
                    "{GSUITE_CREDENTIALS_DIR}": "GSUITE_CREDENTIALS_DIR"
                }
            }
        },
        {
            "id": "ddg-search",
            "description": "Searches DuckDuckGo and fetches web content.",
            "command": {
                "executableEnvVar": "UV_PATH",
                "defaultExecutable": "uv",
                "argsTemplate": [
                    "run",
                    "--directory",
                    "{SCRIPT_DIR}",
                    "-m",
                    "duckduckgo_mcp_server.server"
                ],
                "argSubstitutions": {
                    "{SCRIPT_DIR}": "DDG_MCP_SCRIPT_DIR"
                }
            }
        },
        {
            "id": "sequential-thinking",
            "description": "Node.js server implementation that provides a tool for dynamic and reflective problem-solving through a structured thinking process.",
            "command": {
                "defaultExecutable": "npx",
                "argsTemplate": [
                    "-y",
                    "@modelcontextprotocol/server-sequential-thinking"
                ],
                "argSubstitutions": {},
                "envVars": []
            }
        },
        {
            "id": "memory",
            "description": "Node.js server A basic implementation of persistent memory using a local knowledge graph. This lets the LLM models remember information about the user across chats.",
            "alwaysInitialize": true,
            "command": {
                "defaultExecutable": "npx",
                "argsTemplate": [
                    "-y",
                    "@modelcontextprotocol/server-memory"
                ],
                "argSubstitutions": {},
                "env": {
                    "MEMORY_FILE_PATH": "/Users/abrewer/projects/mcp-agent/mcp-agent-app/memory.json"
                }
            }
        },
        {
            "id": "desktop-commander",
            "description": "Node.js server that allows LLM to execute long-running terminal commands on your computer and manage processes through Model Context Protocol (MCP) + Built on top of MCP Filesystem Server to provide additional search and replace file editing capabilities.",
            "command": {
                "defaultExecutable": "npx",
                "argsTemplate": [
                    "-y",
                    "@wonderwhy-er/desktop-commander"
                ],
                "argSubstitutions": {},
                "envVars": []
            }
        },
        {
            "id": "browsermcp",
            "description": "MCP server for automating your browser.",
            "command": {
                "defaultExecutable": "npx",
                "argsTemplate": [
                    "@browsermcp/mcp@latest"
                ],
                "argSubstitutions": {},
                "envVars": []
            }
        },
        {
            "id": "gdrive",
            "description": "MCP server integrates with Google Drive to allow listing, reading, and searching over files.",
            "command": {
                "defaultExecutable": "npx",
                "argsTemplate": [
                    "@modelcontextprotocol/server-gdrive"
                ],
                "argSubstitutions": {},
                "env": {
                    "GDRIVE_CREDENTIALS_PATH": "/Users/abrewer/projects/mcp-agent/servers/.gdrive-server-credentials.json"
                }
            }
        }
    ]
}